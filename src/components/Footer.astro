---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy-700 text-cream">
  <div class="container-x py-16 grid gap-10 md:grid-cols-2 lg:grid-cols-6">
    <!-- Brand + newsletter -->
    <div class="lg:col-span-2 space-y-5">
      <div>
        <div class="font-display font-bold text-2xl text-white">
          Our <span class="text-gold-400">Town</span>
        </div>
        <p class="text-[10px] font-semibold tracking-[0.2em] text-cream/70 uppercase mt-1">Shop Local · Give Local</p>
      </div>
      <p class="text-cream/80 text-sm max-w-sm">
        A community-powered platform connecting local causes, businesses, and neighbors to build stronger towns together.
      </p>
      <div class="flex gap-3">
        <a href="#" aria-label="Facebook" class="size-9 inline-flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-400 hover:text-ink transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H8v-3h2.4V9.4c0-2.4 1.4-3.7 3.6-3.7 1 0 2.1.2 2.1.2v2.3h-1.2c-1.2 0-1.5.7-1.5 1.5V12h2.6l-.4 3h-2.2v7A10 10 0 0 0 22 12"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="size-9 inline-flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-400 hover:text-ink transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="size-9 inline-flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-400 hover:text-ink transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM8.3 18.3H5.7V10h2.6v8.3zM7 8.8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm11.3 9.5h-2.6v-4c0-1-.4-1.6-1.3-1.6s-1.4.6-1.4 1.6v4h-2.6V10h2.5v1.1c.4-.6 1.1-1.3 2.4-1.3 1.7 0 2.9 1 2.9 3.2v5.3z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <div class="text-sm font-bold text-white uppercase tracking-wider mb-3">Shop</div>
      <ul class="space-y-2 text-sm text-cream/80">
        <li><a href={link('/shoppers')} class="hover:text-gold-400">All Products</a></li>
        <li><a href={link('/shoppers')} class="hover:text-gold-400">New Arrivals</a></li>
        <li><a href={link('/shoppers')} class="hover:text-gold-400">Local Makers</a></li>
        <li><a href={link('/shoppers#baskets')} class="hover:text-gold-400">Gift Ideas</a></li>
      </ul>
    </div>

    <div>
      <div class="text-sm font-bold text-white uppercase tracking-wider mb-3">Causes</div>
      <ul class="space-y-2 text-sm text-cream/80">
        <li><a href={link('/causes')} class="hover:text-gold-400">All Causes</a></li>
        <li><a href={link('/causes#nominate')} class="hover:text-gold-400">Start a Cause</a></li>
        <li><a href={link('/causes')} class="hover:text-gold-400">How It Works</a></li>
        <li><a href={link('/stories')} class="hover:text-gold-400">Success Stories</a></li>
      </ul>
    </div>

    <div>
      <div class="text-sm font-bold text-white uppercase tracking-wider mb-3">Businesses</div>
      <ul class="space-y-2 text-sm text-cream/80">
        <li><a href={link('/businesses')} class="hover:text-gold-400">Partner With Us</a></li>
        <li><a href={link('/businesses')} class="hover:text-gold-400">Business Resources</a></li>
        <li><a href={link('/stories')} class="hover:text-gold-400">Success Stories</a></li>
        <li><a href="https://www.ourtown.store/business/signup" class="hover:text-gold-400">Apply Now</a></li>
      </ul>
    </div>

    <div>
      <div class="text-sm font-bold text-white uppercase tracking-wider mb-3">Company</div>
      <ul class="space-y-2 text-sm text-cream/80">
        <li><a href={link('/about')} class="hover:text-gold-400">About Us</a></li>
        <li><a href={link('/about')} class="hover:text-gold-400">Our Impact</a></li>
        <li><a href={link('/stories')} class="hover:text-gold-400">Blog</a></li>
        <li><a href={link('/contact')} class="hover:text-gold-400">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <!-- Newsletter strip -->
  <div class="border-t border-white/10">
    <div class="container-x py-8 grid md:grid-cols-[1fr_1fr] gap-6 items-center">
      <div>
        <div class="font-display text-lg font-semibold text-white">Stay Connected</div>
        <p class="text-cream/70 text-sm mt-1">Join our newsletter for updates on local causes and community impact.</p>
      </div>
      <form class="flex gap-2" onsubmit="event.preventDefault();">
        <input type="email" required placeholder="Enter your email" class="flex-1 rounded-xl bg-white text-ink px-4 py-3 placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-gold-400" />
        <button type="submit" class="btn-primary !py-3">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-cream/60">
      <span>© {year} Our Town. All rights reserved.</span>
      <div class="flex gap-5">
        <a href="#" class="hover:text-gold-400">Terms of Use</a>
        <a href="#" class="hover:text-gold-400">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
