---
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const nav = [
  { href: '/shoppers', label: 'Shop' },
  { href: '/causes', label: 'Causes' },
  { href: '/businesses', label: 'Businesses' },
  { href: '/stories', label: 'Community Stories' },
  { href: '/about', label: 'About Us' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === base + '/' || pathname === base || pathname === '/';
  return pathname.startsWith(base + href);
};
---
<header class="sticky top-0 z-30 bg-cream/95 backdrop-blur border-b border-ink/5">
  <div class="container-x flex items-center justify-between h-20 gap-6">
    <!-- Logo -->
    <a href={link('/')} class="flex flex-col leading-none">
      <span class="font-display font-bold text-2xl text-navy-700">
        Our <span class="text-gold-500">Town</span>
      </span>
      <span class="text-[10px] font-semibold tracking-[0.2em] text-ink-soft uppercase mt-0.5">
        Shop Local · Give Local
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-7 text-sm">
      {nav.map(({ href, label }) => (
        <a
          href={link(href)}
          class:list={[
            'transition hover:text-gold-600',
            isActive(href) ? 'text-gold-600 font-semibold' : 'text-ink/80 font-medium',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Utility -->
    <div class="hidden md:flex items-center gap-3">
      <a href="https://www.ourtown.store/auth/signin" class="btn-outline !px-4 !py-2 text-sm">Sign In</a>
      <a href={link('/causes#nominate')} class="btn-primary !px-4 !py-2 text-sm">Start a Cause</a>
      <a href="https://www.ourtown.store/consumer/cart" aria-label="Cart" class="p-2 text-ink hover:text-gold-600 transition">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>
        </svg>
      </a>
    </div>

    <!-- Mobile toggle -->
    <button id="navToggle" class="lg:hidden p-2 -mr-2" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="20" y2="17"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <div id="mobileNav" class="lg:hidden hidden border-t border-ink/5 bg-cream">
    <nav class="container-x py-4 flex flex-col gap-3 text-sm">
      {nav.map(({ href, label }) => (
        <a href={link(href)} class="py-1.5 text-ink/85 hover:text-gold-600 font-medium">{label}</a>
      ))}
      <div class="flex flex-wrap gap-2 mt-3">
        <a href="https://www.ourtown.store/auth/signin" class="btn-outline !px-4 !py-2 text-sm">Sign In</a>
        <a href={link('/causes#nominate')} class="btn-primary !px-4 !py-2 text-sm">Start a Cause</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const t = document.getElementById('navToggle');
  const m = document.getElementById('mobileNav');
  t?.addEventListener('click', () => m?.classList.toggle('hidden'));
</script>
