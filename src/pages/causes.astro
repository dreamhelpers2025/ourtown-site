---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const themes = [
  { title: 'Pollinators & local ecology', body: 'Native bees, heirloom seed banks, watershed protection.' },
  { title: 'Food security', body: 'Pantries, community fridges, school meal funds.' },
  { title: 'Animal welfare', body: 'Local shelters, wildlife rehab, working-animal sanctuaries.' },
  { title: 'Youth & education', body: 'After-school programs, library funds, scholarships.' },
  { title: 'Arts & culture', body: 'Theater groups, mural funds, historic preservation.' },
  { title: 'Neighbor support', body: 'Housing assistance, veteran services, mutual-aid networks.' },
];

const benefits = [
  { title: 'Recurring funding without the ask', body: 'Every transaction in your community can contribute — no campaign, no annual gala required.' },
  { title: 'You don\'t handle the plumbing', body: 'We collect, split, and disburse. You get a clean monthly statement and direct deposit.' },
  { title: 'Local businesses become amplifiers', body: 'Shops can attach your cause to their storefront so every sale lifts your mission.' },
];
---
<BaseLayout title="For Causes — Our Town" description="Get your local nonprofit listed for free. Receive a portion of every purchase shoppers and businesses choose to direct your way.">
  <section class="container-x pt-20 pb-12 grid md:grid-cols-[1.3fr_1fr] gap-10 items-center">
    <div>
      <p class="eyebrow mb-4">For Causes</p>
      <h1 class="text-4xl md:text-5xl">Funding that grows with the place you serve.</h1>
      <p class="mt-6 text-lg text-ink-soft max-w-2xl">
        Your nonprofit becomes selectable at checkout in every local shop on Our Town. No grant writing. No middlemen. Just a steady, transparent stream of community-driven dollars.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#nominate" class="btn-primary">Get my cause listed</a>
        <a href="https://www.ourtown.store/cause/near" class="btn-ghost">See current causes</a>
      </div>
      <p class="mt-6 text-xs text-ink/50 uppercase tracking-[0.18em]">Free forever · 501(c)(3) or fiscally sponsored</p>
    </div>
    <div class="rounded-3xl bg-gradient-to-br from-ink to-forest-700 text-white p-8">
      <p class="text-white/60 text-xs uppercase tracking-widest">Your cut, per transaction</p>
      <div class="font-display text-6xl mt-2 leading-none">5–15<span class="text-3xl">%</span></div>
      <p class="mt-3 text-white/80">of the purchase price, sent directly to your account on a regular schedule.</p>
      <div class="mt-8 border-t border-white/20 pt-6 grid grid-cols-3 text-sm">
        <div><div class="text-2xl font-display">$0</div><div class="text-white/60 text-xs mt-1">Listing fee</div></div>
        <div><div class="text-2xl font-display">100%</div><div class="text-white/60 text-xs mt-1">Pass-through</div></div>
        <div><div class="text-2xl font-display">Live</div><div class="text-white/60 text-xs mt-1">Reporting</div></div>
      </div>
    </div>
  </section>

  <!-- Why list -->
  <section class="container-x py-16">
    <div class="max-w-2xl mb-10">
      <p class="eyebrow mb-3">Why list your cause</p>
      <h2 class="text-3xl md:text-4xl">A new revenue line that doesn't compete with your donors.</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {benefits.map((b) => (
        <div class="card hover:shadow-lg transition">
          <h3 class="text-lg">{b.title}</h3>
          <p class="mt-2 text-ink-soft">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Themes -->
  <section class="bg-white border-y border-ink/10">
    <div class="container-x py-20">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-3">What we list</p>
        <h2 class="text-3xl md:text-4xl">Causes rooted in a specific place.</h2>
        <p class="mt-5 text-ink-soft">If your work makes one town measurably better, you fit.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {themes.map((t) => (
          <div class="card">
            <h3 class="text-lg">{t.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nominate form -->
  <section id="nominate" class="container-x py-20">
    <div class="grid md:grid-cols-[1fr_1.2fr] gap-10">
      <div>
        <p class="eyebrow mb-3">Get listed</p>
        <h2 class="text-3xl md:text-4xl">Nominate a cause.</h2>
        <p class="mt-5 text-ink-soft">Yourself, your favorite nonprofit, or one you wish more people knew about. We review every submission within a week.</p>
        <ul class="mt-6 space-y-3 text-sm text-ink-soft">
          <li class="flex gap-3"><span class="mt-2 size-1.5 rounded-full bg-gold-400"></span>Free to list, free to stay</li>
          <li class="flex gap-3"><span class="mt-2 size-1.5 rounded-full bg-gold-400"></span>You control your page, photos, and story</li>
          <li class="flex gap-3"><span class="mt-2 size-1.5 rounded-full bg-gold-400"></span>Direct deposit on a regular schedule</li>
        </ul>
      </div>
      <form action="https://formspree.io/f/your-id" method="POST" class="rounded-3xl bg-white border border-ink/10 p-8 space-y-5">
        <div>
          <label class="block text-sm font-medium" for="cause">Cause name</label>
          <input id="cause" name="cause" required class="mt-1 w-full rounded-lg border border-ink/15 px-3 py-2 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400" />
        </div>
        <div>
          <label class="block text-sm font-medium" for="contact">Contact name</label>
          <input id="contact" name="contact" required class="mt-1 w-full rounded-lg border border-ink/15 px-3 py-2 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400" />
        </div>
        <div>
          <label class="block text-sm font-medium" for="email">Email</label>
          <input id="email" type="email" name="email" required class="mt-1 w-full rounded-lg border border-ink/15 px-3 py-2 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400" />
        </div>
        <div>
          <label class="block text-sm font-medium" for="city">City / town</label>
          <input id="city" name="city" required class="mt-1 w-full rounded-lg border border-ink/15 px-3 py-2 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400" />
        </div>
        <div>
          <label class="block text-sm font-medium" for="mission">Mission in one sentence</label>
          <textarea id="mission" name="mission" rows="3" required class="mt-1 w-full rounded-lg border border-ink/15 px-3 py-2 focus:border-gold-400 focus:outline-none focus:ring-1 focus:ring-gold-400"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Submit nomination</button>
        <p class="text-xs text-ink/50">Replace the Formspree URL above with a live endpoint before going to production.</p>
      </form>
    </div>
  </section>
</BaseLayout>
