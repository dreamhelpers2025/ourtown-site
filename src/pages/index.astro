---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

// Seeded photos — replace with real community photography before launch.
const photo = (seed: string, w = 600, h = 400) => `https://picsum.photos/seed/${seed}/${w}/${h}`;

const howCards = [
  {
    icon: 'bag',
    iconBg: 'bg-gold-400',
    badge: '1.',
    badgeColor: 'text-gold-600',
    title: 'Shop With Purpose',
    body: 'Buy local merchandise and community products that directly support causes in your town.',
    cta: 'Browse Causes',
    href: '/causes',
    btnClass: 'btn-primary',
    photo: photo('shopping', 800, 500),
  },
  {
    icon: 'heart',
    iconBg: 'bg-forest-500',
    badge: '2.',
    badgeColor: 'text-forest-600',
    title: 'Raise Funds Locally',
    body: 'Create campaigns, sell merchandise, and rally supporters without needing a complicated fundraising platform.',
    cta: 'Start a Cause Page',
    href: '/causes#nominate',
    btnClass: 'btn-forest',
    photo: photo('community-team', 800, 500),
  },
  {
    icon: 'store',
    iconBg: 'bg-navy-600',
    badge: '3.',
    badgeColor: 'text-navy-700',
    title: 'Partner & Grow',
    body: 'Connect your business with local supporters while giving back to causes people care about.',
    cta: 'Partner With Us',
    href: '/businesses',
    btnClass: 'btn-navy',
    photo: photo('open-shop', 800, 500),
  },
];

const stats = [
  { icon: 'heart', value: '$248,732', label: 'Raised for Local Causes' },
  { icon: 'people', value: '162', label: 'Local Causes Supported' },
  { icon: 'store', value: '248', label: 'Participating Businesses' },
  { icon: 'bag', value: '18,654', label: 'Community Purchases' },
];

const causes = [
  { name: 'Westview Youth Baseball', tagline: 'New uniforms and equipment for our amazing athletes.', raised: 4250, goal: 5000, seed: 'baseball-kids' },
  { name: 'Riverside Fire Department', tagline: 'Funding new gear to keep our community safe.', raised: 6780, goal: 10000, seed: 'firetruck' },
  { name: 'Paws & Friends Rescue', tagline: 'Help us provide food, shelter, and medical care.', raised: 3125, goal: 5000, seed: 'rescue-dog' },
  { name: 'Lincoln Elementary PTA', tagline: 'Support classroom resources and student programs.', raised: 2910, goal: 4000, seed: 'classroom' },
  { name: 'Keep Our Town Beautiful', tagline: 'Clean parks, safe streets, stronger community.', raised: 1845, goal: 3000, seed: 'park-cleanup' },
];

const businesses = [
  { name: 'Main Street Coffee', tagline: 'Locally roasted. Community focused.', seed: 'coffee-shop' },
  { name: 'Riverside Market', tagline: 'Fresh, local, and made with care.', seed: 'market-front' },
  { name: 'Hometown Threads', tagline: 'Wear your town with pride.', seed: 'apparel-shop' },
  { name: 'The Book Nook', tagline: 'Books, gifts, and a love for our community.', seed: 'bookstore' },
  { name: 'Green Valley Gardens', tagline: 'Plants for every season and every reason.', seed: 'garden-shop' },
];

const stories = [
  { tag: 'Cause Story', title: 'How One Team Rallied a Town', body: 'Westview Baseball reached their goal with community support.', seed: 'team-celebrate' },
  { tag: 'Business Story', title: 'More Than a Coffee Shop', body: 'How Main Street Coffee gives back every single day.', seed: 'coffee-owner' },
  { tag: 'Community Story', title: 'Stronger Together', body: 'Our Town events that bring neighbors closer.', seed: 'community-event' },
];

const typical = [
  'Temporary campaigns',
  'High fees & complicated tools',
  'Limited local visibility',
  'One-time transactions',
  'Disconnected from local businesses',
];
const ours = [
  'Ongoing local support',
  'Low fees, built for communities',
  'Local visibility that lasts',
  'Everyday purchases that give back',
  'Businesses and causes grow together',
];

const pct = (a: number, b: number) => Math.min(100, Math.round((a / b) * 100));
const fmt = (n: number) => '$' + n.toLocaleString();
---
<BaseLayout>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-cream">
    <div class="absolute -right-32 top-10 w-[60%] h-[80%] brush-yellow -z-0 opacity-90 pointer-events-none"></div>
    <div class="container-x relative pt-12 md:pt-16 pb-16 md:pb-20 grid lg:grid-cols-[1.05fr_1fr] gap-10 items-center">
      <!-- Left: copy -->
      <div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] text-navy-700">
          Your Community<br/>Has a <span class="text-gold-500 relative inline-block">Storefront
            <svg class="absolute -bottom-2 left-0 w-full" height="10" viewBox="0 0 200 10" preserveAspectRatio="none"><path d="M2 7 Q 50 0 100 5 T 198 4" stroke="#e8b63e" stroke-width="4" fill="none" stroke-linecap="round"/></svg>
          </span>
        </h1>
        <p class="mt-6 text-lg text-ink-soft max-w-md">
          Support local causes and businesses through everyday purchases that give back to your town.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={link('/shoppers')} class="group rounded-2xl bg-gold-400 hover:bg-gold-500 px-5 py-4 flex items-center gap-3 shadow-soft transition">
            <span class="size-9 rounded-full bg-white/40 inline-flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </span>
            <span class="text-left leading-tight">
              <span class="block font-bold text-ink">Shop to Support</span>
              <span class="block text-xs text-ink/70">Find products that give back</span>
            </span>
          </a>
          <a href={link('/causes#nominate')} class="group rounded-2xl bg-forest-500 hover:bg-forest-600 text-white px-5 py-4 flex items-center gap-3 shadow-soft transition">
            <span class="size-9 rounded-full bg-white/15 inline-flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </span>
            <span class="text-left leading-tight">
              <span class="block font-bold">Register Your Cause</span>
              <span class="block text-xs text-white/80">Raise funds & awareness</span>
            </span>
          </a>
          <a href={link('/businesses')} class="group rounded-2xl bg-navy-700 hover:bg-navy-800 text-white px-5 py-4 flex items-center gap-3 shadow-soft transition">
            <span class="size-9 rounded-full bg-white/15 inline-flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v11h18V9"/><path d="M9 22V12h6v10"/></svg>
            </span>
            <span class="text-left leading-tight">
              <span class="block font-bold">Grow Your Business</span>
              <span class="block text-xs text-white/80">Partner & reach more locals</span>
            </span>
          </a>
        </div>
        <p class="mt-6 text-sm text-ink-soft flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#e8b63e" stroke="#965e18" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Every purchase helps fund local impact.
        </p>
      </div>

      <!-- Right: photo collage -->
      <div class="relative aspect-[5/5] md:aspect-[6/5]">
        <div class="absolute top-0 right-2 w-[58%] aspect-[5/3] rounded-2xl overflow-hidden shadow-card border-4 border-white rotate-2">
          <img src={photo('volunteers-yellow', 700, 420)} alt="Community volunteers" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute bottom-6 left-0 w-[46%] aspect-square rounded-2xl overflow-hidden shadow-card border-4 border-white -rotate-3">
          <img src={photo('shop-owner', 500, 500)} alt="Local business owner" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute bottom-0 left-[44%] w-[40%] aspect-square rounded-2xl overflow-hidden shadow-card border-4 border-white rotate-2">
          <img src={photo('community-hug', 500, 500)} alt="Community youth team" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute top-12 right-0 w-[28%] aspect-[3/5] rounded-2xl overflow-hidden shadow-card border-4 border-white rotate-3 hidden md:block">
          <img src={photo('main-street', 320, 520)} alt="Main street" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute top-[42%] right-[20%] size-16 rounded-full bg-gold-400 text-ink font-display font-bold text-[10px] flex items-center justify-center text-center leading-tight shadow-card border-4 border-white uppercase tracking-wider">Stronger<br/>Together</div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-cream py-20">
    <div class="container-x">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl md:text-4xl text-navy-700 heading-underline">How Our Town Works</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {howCards.map((c) => (
          <article class="card flex flex-col overflow-hidden !p-0">
            <div class="relative h-44 overflow-hidden">
              <img src={c.photo} alt="" loading="lazy" class="w-full h-full object-cover" />
              <span class={`absolute top-4 left-4 size-12 rounded-full ${c.iconBg} text-white inline-flex items-center justify-center shadow-card`}>
                {c.icon === 'bag' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>}
                {c.icon === 'heart' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
                {c.icon === 'store' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v11h18V9"/><path d="M9 22V12h6v10"/></svg>}
              </span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl"><span class={`font-display font-bold mr-1 ${c.badgeColor}`}>{c.badge}</span>{c.title}</h3>
              <p class="mt-3 text-ink-soft text-sm flex-1">{c.body}</p>
              <a href={link(c.href)} class={`${c.btnClass} mt-5 self-start group`}>
                {c.cta}
                <svg class="w-4 h-4 ml-2 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- IMPACT STRIP -->
  <section class="bg-navy-700 text-white py-12">
    <div class="container-x grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((s) => (
        <div class="stat flex flex-col items-center gap-2">
          <span class="size-10 inline-flex items-center justify-center rounded-full bg-white/10 text-gold-400">
            {s.icon === 'heart' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
            {s.icon === 'people' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            {s.icon === 'store' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v11h18V9"/></svg>}
            {s.icon === 'bag' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/></svg>}
          </span>
          <div class="stat-num text-gold-400">{s.value}</div>
          <div class="text-sm text-cream/85">{s.label}</div>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-cream/70 text-sm">Growing every month in communities across America.</p>
  </section>

  <!-- FEATURED CAUSES -->
  <section class="bg-cream py-20">
    <div class="container-x">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <h2 class="font-display text-2xl md:text-3xl text-navy-700">Featured Local Causes</h2>
        <a href={link('/causes')} class="text-gold-600 hover:text-gold-700 font-semibold text-sm inline-flex items-center gap-1">View all causes →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {causes.map((c) => (
          <article class="card !p-0 overflow-hidden flex flex-col hover:shadow-lg transition">
            <div class="aspect-[5/4] overflow-hidden">
              <img src={photo(c.seed, 400, 320)} alt={c.name} loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-base font-display font-semibold text-navy-700 leading-tight">{c.name}</h3>
              <p class="mt-2 text-xs text-ink-soft leading-snug flex-1">{c.tagline}</p>
              <div class="mt-3">
                <div class="flex items-end justify-between">
                  <span class="font-display font-bold text-ink">{fmt(c.raised)}</span>
                  <span class="text-[10px] text-ink-soft uppercase tracking-wide">{pct(c.raised, c.goal)}% of {fmt(c.goal)} goal</span>
                </div>
                <div class="mt-1 h-1.5 bg-cream-200 rounded-full overflow-hidden">
                  <div class="h-full bg-forest-500 rounded-full" style={`width:${pct(c.raised, c.goal)}%`}></div>
                </div>
              </div>
              <button class="btn-primary mt-4 w-full !py-2 text-sm">
                <svg class="w-4 h-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                Support This Cause
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED BUSINESSES -->
  <section class="bg-cream pb-20">
    <div class="container-x">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <h2 class="font-display text-2xl md:text-3xl text-navy-700">Featured Local Businesses</h2>
        <a href={link('/businesses')} class="text-gold-600 hover:text-gold-700 font-semibold text-sm inline-flex items-center gap-1">View all businesses →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {businesses.map((b) => (
          <article class="card !p-0 overflow-hidden flex flex-col hover:shadow-lg transition">
            <div class="aspect-[5/4] overflow-hidden bg-cream-200">
              <img src={photo(b.seed, 400, 320)} alt={b.name} loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-base font-display font-semibold text-navy-700 leading-tight">{b.name}</h3>
              <p class="mt-1 text-xs text-ink-soft leading-snug flex-1">{b.tagline}</p>
              <span class="mt-3 self-start inline-flex items-center gap-1 text-[10px] font-semibold text-forest-600 bg-forest-50 px-2 py-1 rounded-full">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                Supports Local Causes
              </span>
              <button class="btn-primary mt-4 w-full !py-2 text-sm">Shop Now</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMMUNITY STORIES -->
  <section class="bg-cream pb-20">
    <div class="container-x">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <h2 class="font-display text-2xl md:text-3xl text-navy-700">Community Stories</h2>
        <a href={link('/stories')} class="text-gold-600 hover:text-gold-700 font-semibold text-sm inline-flex items-center gap-1">Read all stories →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {stories.map((s) => (
          <a href={link('/stories')} class="group relative aspect-[4/3] rounded-3xl overflow-hidden shadow-card block">
            <img src={photo(s.seed, 700, 525)} alt={s.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/90 via-navy-900/40 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gold-400">{s.tag}</span>
              <h3 class="mt-1 font-display text-lg leading-tight text-white">{s.title}</h3>
              <p class="mt-1 text-xs text-cream/85">{s.body}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-gold-400">Read More →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY DIFFERENT -->
  <section class="bg-cream pb-20">
    <div class="container-x">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl md:text-4xl text-navy-700 heading-underline">Why Our Town is Different</h2>
      </div>
      <div class="relative rounded-3xl bg-white shadow-card border border-ink/5 p-8 md:p-12 grid md:grid-cols-[1fr_auto_1fr] gap-6 md:gap-10 items-center">
        <div>
          <h3 class="text-xl font-display font-semibold text-ink-soft mb-4">Typical Fundraising</h3>
          <ul class="space-y-3 text-sm">
            {typical.map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 size-5 rounded-full bg-red-100 text-red-500 inline-flex items-center justify-center shrink-0">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </span>
                <span class="text-ink-soft">{t}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="hidden md:flex flex-col items-center justify-center">
          <div class="size-14 rounded-full bg-gold-400 text-ink font-display font-bold text-lg flex items-center justify-center shadow-card">VS.</div>
        </div>
        <div>
          <h3 class="text-xl font-display font-semibold text-navy-700 mb-4">Our Town</h3>
          <ul class="space-y-3 text-sm">
            {ours.map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 size-5 rounded-full bg-forest-100 text-forest-600 inline-flex items-center justify-center shrink-0">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="text-ink">{t}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-gold-400">
    <div class="container-x py-10 grid md:grid-cols-[1fr_auto] gap-6 items-center">
      <div>
        <h2 class="font-display text-2xl md:text-3xl text-ink">Stronger Communities Start Local</h2>
        <p class="text-ink-soft text-sm mt-1">Choose how you want to make an impact today.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/shoppers')} class="btn-navy">
          <svg width="16" height="16" class="mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/></svg>
          Shop to Support
        </a>
        <a href={link('/causes#nominate')} class="btn-forest">
          <svg width="16" height="16" class="mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Register Your Cause
        </a>
        <a href={link('/businesses')} class="btn-outline">
          <svg width="16" height="16" class="mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v11h18V9"/></svg>
          Partner Your Business
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
