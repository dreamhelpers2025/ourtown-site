---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const audiences = [
  {
    eyebrow: 'I want to shop',
    title: 'Spend where it matters most.',
    body: 'Browse local stores, products, and curated baskets. A slice of every purchase goes to a cause you choose.',
    cta: 'Start shopping',
    href: '/shoppers',
    tone: 'bg-brand-500 text-white hover:bg-brand-600',
    accent: 'text-brand-100',
  },
  {
    eyebrow: 'I run a business',
    title: 'Reach customers who care.',
    body: 'List your store, keep 80–90% of every sale, and connect with shoppers actively looking to spend locally.',
    cta: 'List your store',
    href: '/businesses',
    tone: 'bg-accent-700 text-white hover:bg-accent-800',
    accent: 'text-accent-100',
  },
  {
    eyebrow: 'I represent a cause',
    title: 'Turn local goodwill into funding.',
    body: 'Get listed for free. Shoppers and businesses send a portion of every transaction directly to your mission.',
    cta: 'Add your cause',
    href: '/causes',
    tone: 'bg-ink text-white hover:bg-ink/90',
    accent: 'text-white/70',
  },
];

const split = [
  { label: 'Local business', value: '80–90%', sub: 'stays with the shop that earned it' },
  { label: 'Your chosen cause', value: '5–15%', sub: 'sent directly to a local nonprofit' },
  { label: 'Our Town', value: '5%', sub: 'keeps the platform running' },
];

const steps = [
  { n: '01', title: 'Discover', body: 'Browse nearby stores, products, and curated baskets — filtered to your community.' },
  { n: '02', title: 'Choose your cause', body: 'Pick a local nonprofit at checkout. Your contribution is itemized and visible in real time.' },
  { n: '03', title: 'Shop with impact', body: 'Funds split automatically: the business gets paid, the cause gets funded, you get the goods.' },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-cream via-sand to-brand-100"></div>
    <div class="absolute inset-x-0 -top-32 -z-10 h-72 bg-[radial-gradient(60%_60%_at_50%_50%,rgba(236,111,16,0.18),transparent)]"></div>
    <div class="container-x pt-20 pb-24 md:pt-28 md:pb-32 grid md:grid-cols-[1.15fr_1fr] gap-12 items-center">
      <div>
        <p class="eyebrow mb-4">Local Difference Makers</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl leading-[1.05]">
          Every purchase, a vote for the <span class="text-brand-600">place you live</span>.
        </h1>
        <p class="mt-6 text-lg text-ink-soft max-w-prose">
          Our Town is the marketplace where shopping local funds the causes local people care about. One basket. Three winners — the business, the cause, and your community.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={link('/shoppers')} class="btn-primary">Shop local now</a>
          <a href={link('/businesses')} class="btn-ghost">List your business</a>
        </div>
        <p class="mt-6 text-xs text-ink/50 uppercase tracking-[0.18em]">No fees for shoppers · Free for causes</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="aspect-square rounded-3xl bg-gradient-to-br from-brand-400 to-brand-600 p-6 text-white flex flex-col justify-between shadow-sm">
          <span class="text-xs uppercase tracking-widest opacity-80">Stores</span>
          <div>
            <div class="font-display text-3xl leading-none">Main Street, online.</div>
            <p class="text-sm mt-2 opacity-90">Coffee roasters, bookstores, makers — discoverable in one place.</p>
          </div>
        </div>
        <div class="aspect-square rounded-3xl bg-white p-6 flex flex-col justify-between border border-ink/10 shadow-sm">
          <span class="text-xs uppercase tracking-widest text-accent-700">Causes</span>
          <div>
            <div class="font-display text-3xl leading-none text-ink">Pollinators. Pantries. Pets.</div>
            <p class="text-sm mt-2 text-ink-soft">Pick the local nonprofit your purchase supports.</p>
          </div>
        </div>
        <div class="aspect-square rounded-3xl bg-accent-700 p-6 text-white flex flex-col justify-between shadow-sm">
          <span class="text-xs uppercase tracking-widest opacity-80">Baskets</span>
          <div>
            <div class="font-display text-3xl leading-none">Curated, by neighbors.</div>
            <p class="text-sm mt-2 opacity-90">One-click gift sets that bundle local goods around a theme.</p>
          </div>
        </div>
        <div class="aspect-square rounded-3xl bg-ink p-6 text-white flex flex-col justify-between shadow-sm">
          <span class="text-xs uppercase tracking-widest opacity-70">Real-time</span>
          <div>
            <div class="font-display text-3xl leading-none">See the impact.</div>
            <p class="text-sm mt-2 opacity-80">Watch funds flow to causes as the community shops.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three audiences -->
  <section class="container-x py-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Three paths, one community</p>
        <h2 class="text-3xl md:text-4xl">What brings you to Our Town?</h2>
      </div>
      <p class="text-ink-soft max-w-md">Pick the door that fits — each takes you straight to what you came to do.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {audiences.map((a) => (
        <a href={link(a.href)} class={`group rounded-3xl p-8 flex flex-col justify-between min-h-[300px] transition ${a.tone}`}>
          <div>
            <p class={`text-xs uppercase tracking-[0.2em] font-semibold ${a.accent}`}>{a.eyebrow}</p>
            <h3 class="mt-3 text-2xl text-white">{a.title}</h3>
            <p class={`mt-3 text-sm ${a.accent}`}>{a.body}</p>
          </div>
          <div class="mt-8 inline-flex items-center gap-2 font-medium">
            {a.cta}
            <svg class="w-4 h-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- How the money flows -->
  <section class="bg-white border-y border-ink/10">
    <div class="container-x py-20">
      <div class="max-w-2xl mb-12">
        <p class="eyebrow mb-3">Transparent by design</p>
        <h2 class="text-3xl md:text-4xl">Here's exactly where your dollar goes.</h2>
        <p class="mt-5 text-ink-soft">No mystery fees, no middlemen skimming. Every checkout shows the split before you pay.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {split.map((s) => (
          <div class="card">
            <div class="font-display text-5xl text-brand-600">{s.value}</div>
            <div class="mt-4 font-semibold">{s.label}</div>
            <div class="mt-1 text-sm text-ink-soft">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-x py-24">
    <div class="max-w-2xl mb-14">
      <p class="eyebrow mb-3">How it works</p>
      <h2 class="text-3xl md:text-4xl">From browse to impact in three steps.</h2>
    </div>
    <ol class="grid md:grid-cols-3 gap-6">
      {steps.map((s) => (
        <li class="card">
          <div class="font-display text-brand-600 text-3xl">{s.n}</div>
          <h3 class="mt-4 text-xl">{s.title}</h3>
          <p class="mt-3 text-ink-soft">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="container-x pb-24">
    <div class="rounded-3xl bg-gradient-to-br from-accent-700 to-accent-800 text-white p-10 md:p-16 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl text-white">Communities are stronger when they support each other.</h2>
        <p class="mt-4 text-accent-100/90 max-w-prose">
          Whether you're shopping, selling, or fundraising — Our Town is the easiest way to keep money and momentum in your neighborhood.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/shoppers')} class="btn bg-white text-accent-800 hover:bg-cream">Start shopping</a>
        <a href={link('/about')} class="btn border border-white/30 text-white hover:bg-white/10">Read our story</a>
      </div>
    </div>
  </section>
</BaseLayout>
