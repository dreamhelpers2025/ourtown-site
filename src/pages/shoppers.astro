---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const categories = [
  { title: 'Stores', body: 'Discover independent shops near you — open hours, products, story behind the counter.', icon: '🏪' },
  { title: 'Products', body: 'Search across every local seller for the one item you actually want.', icon: '🛍️' },
  { title: 'Causes', body: 'Browse local nonprofits and choose which one earns from your purchase.', icon: '🌱' },
  { title: 'Baskets', body: 'Curated themed bundles from multiple local makers — perfect for gifts.', icon: '🎁' },
];

const faqs = [
  { q: 'Does shopping here cost more?', a: 'No. Prices are set by the businesses. The cause contribution is part of what the seller already keeps — Our Town does not add a shopper fee.' },
  { q: 'Can I split a purchase between several causes?', a: 'Yes. Pick one cause per item, or send everything to a single mission. You see the breakdown before you check out.' },
  { q: 'How do I know the cause actually receives the money?', a: 'Every transaction shows a real-time itemized split. Causes log into a dashboard to track payouts directly.' },
];
---
<BaseLayout title="Shop Local — Our Town" description="Browse local stores, products, and curated baskets. Choose a cause at checkout — your purchase funds the businesses and missions that make your community better.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">For Shoppers</p>
    <h1 class="text-4xl md:text-5xl max-w-3xl">Shop the businesses you love. Fund the causes you believe in.</h1>
    <p class="mt-6 text-lg text-ink-soft max-w-2xl">
      Same products. Same prices. Real local impact baked in.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="https://www.ourtown.store/business/store/near" class="btn-primary">Browse nearby stores</a>
      <a href="https://www.ourtown.store/cause/near" class="btn-ghost">See local causes</a>
    </div>
  </section>

  <!-- What you can shop -->
  <section class="container-x py-16">
    <h2 class="text-2xl md:text-3xl mb-10">Four ways to discover what's local.</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {categories.map((c) => (
        <div class="card hover:shadow-lg transition">
          <div class="text-3xl">{c.icon}</div>
          <h3 class="mt-4 text-lg">{c.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Baskets feature -->
  <section id="baskets" class="bg-white border-y border-ink/10">
    <div class="container-x py-20 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="eyebrow mb-3">Featured: Baskets</p>
        <h2 class="text-3xl md:text-4xl">Pre-curated gifts that pull together the best of your town.</h2>
        <p class="mt-5 text-ink-soft">
          A neighbor-curator picks 3–5 items from local sellers around a theme — a new-baby basket, a "welcome to the neighborhood" basket, a host gift. One checkout. One cause. Many local wins.
        </p>
        <a href="https://www.ourtown.store/" class="mt-6 inline-flex btn-primary">Explore baskets</a>
      </div>
      <ul class="grid grid-cols-2 gap-4">
        <li class="aspect-square rounded-2xl bg-gold-100 p-5 flex items-end font-display text-2xl text-navy-800">Welcome Home</li>
        <li class="aspect-square rounded-2xl bg-forest-100 p-5 flex items-end font-display text-2xl text-forest-700">Garden Starter</li>
        <li class="aspect-square rounded-2xl bg-cream-200 p-5 flex items-end font-display text-2xl text-ink">Coffee + Cozy</li>
        <li class="aspect-square rounded-2xl bg-gold-400 p-5 flex items-end font-display text-2xl text-white">Birthday in a Box</li>
      </ul>
    </div>
  </section>

  <!-- Steps -->
  <section class="container-x py-20">
    <div class="grid md:grid-cols-[1fr_2fr] gap-12">
      <div>
        <p class="eyebrow mb-3">How shopping works</p>
        <h2 class="text-3xl md:text-4xl">Four taps. Lasting impact.</h2>
      </div>
      <ol class="space-y-6">
        <li class="flex gap-5"><span class="font-display text-3xl text-gold-600 leading-none">1</span><div><h3 class="text-lg">Find what you need</h3><p class="text-ink-soft mt-1">Search by product, store, or cause near you.</p></div></li>
        <li class="flex gap-5"><span class="font-display text-3xl text-gold-600 leading-none">2</span><div><h3 class="text-lg">Add to cart</h3><p class="text-ink-soft mt-1">Mix items from any local seller into a single basket.</p></div></li>
        <li class="flex gap-5"><span class="font-display text-3xl text-gold-600 leading-none">3</span><div><h3 class="text-lg">Choose your cause</h3><p class="text-ink-soft mt-1">Pick a local nonprofit. See the contribution itemized in real time.</p></div></li>
        <li class="flex gap-5"><span class="font-display text-3xl text-gold-600 leading-none">4</span><div><h3 class="text-lg">Check out</h3><p class="text-ink-soft mt-1">Funds split automatically — business, cause, platform. Done.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-x pb-20">
    <h2 class="text-2xl md:text-3xl mb-8">Shopper questions, answered.</h2>
    <div class="grid md:grid-cols-3 gap-5">
      {faqs.map((f) => (
        <div class="card">
          <h3 class="text-base font-semibold">{f.q}</h3>
          <p class="mt-2 text-sm text-ink-soft">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="rounded-3xl bg-gold-400 text-white p-10 md:p-14 grid md:grid-cols-[1.5fr_1fr] gap-6 items-center">
      <h2 class="text-3xl md:text-4xl text-white">Ready to spend like a neighbor?</h2>
      <a href="https://www.ourtown.store/business/store/near" class="btn bg-white text-navy-700 hover:bg-cream md:justify-self-end">Browse nearby stores →</a>
    </div>
  </section>
</BaseLayout>
