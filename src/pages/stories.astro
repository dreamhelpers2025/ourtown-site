---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;
const photo = (seed: string, w = 600, h = 400) => `https://picsum.photos/seed/${seed}/${w}/${h}`;

const featured = {
  tag: 'Cause Story',
  title: 'How One Team Rallied a Town',
  body: 'Westview Baseball needed $5,000 for new uniforms. Their hometown bought 312 hats, 89 mugs, and a whole lot of coffee — and the goal was funded in 23 days.',
  seed: 'team-celebrate-large',
};

const stories = [
  { tag: 'Business Story', title: 'More Than a Coffee Shop', body: 'How Main Street Coffee turned a morning ritual into ongoing support for the local fire department.', seed: 'coffee-owner', read: '4 min read' },
  { tag: 'Community Story', title: 'Stronger Together', body: 'Our Town events that bring neighbors closer — and what we learned hosting the first one.', seed: 'community-event', read: '6 min read' },
  { tag: 'Cause Story', title: 'Saving the Heirloom Orchard', body: 'A small nonprofit, a forgotten apple variety, and a town that decided not to let it disappear.', seed: 'orchard', read: '5 min read' },
  { tag: 'Business Story', title: 'The Bookstore That Wouldn\'t Close', body: 'Why The Book Nook is still standing — and how local readers made it possible.', seed: 'bookstore-inside', read: '3 min read' },
  { tag: 'Community Story', title: 'Pollinators and Pride', body: 'A garden shop, a beekeeper, and a school — building habitat one Saturday at a time.', seed: 'bees-garden', read: '5 min read' },
  { tag: 'Cause Story', title: 'Paws & Friends Year One', body: 'How a brand-new rescue covered its first surgery month thanks to local sales.', seed: 'rescue-pup', read: '4 min read' },
];
---
<BaseLayout title="Community Stories — Our Town" description="Real stories from local businesses, causes, and neighbors building stronger towns through Our Town.">
  <section class="container-x pt-12 md:pt-16 pb-10">
    <div class="text-center">
      <p class="eyebrow mb-3">Community Stories</p>
      <h1 class="font-display text-4xl md:text-5xl text-navy-700 heading-underline">Real towns. Real impact.</h1>
      <p class="mt-8 text-lg text-ink-soft max-w-2xl mx-auto">
        The neighbors, shops, and causes making something happen — in their own words.
      </p>
    </div>
  </section>

  <!-- Featured -->
  <section class="container-x pb-16">
    <a href="#" class="group grid md:grid-cols-2 gap-8 rounded-3xl overflow-hidden bg-white shadow-card border border-ink/5">
      <div class="aspect-[4/3] md:aspect-auto overflow-hidden">
        <img src={photo(featured.seed, 900, 700)} alt={featured.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
      </div>
      <div class="p-8 md:p-12 flex flex-col justify-center">
        <span class="text-[10px] font-bold uppercase tracking-widest text-gold-600">Featured · {featured.tag}</span>
        <h2 class="mt-2 font-display text-3xl md:text-4xl text-navy-700 leading-tight">{featured.title}</h2>
        <p class="mt-4 text-ink-soft">{featured.body}</p>
        <span class="mt-6 inline-flex items-center gap-2 text-gold-600 font-semibold">Read the story →</span>
      </div>
    </a>
  </section>

  <!-- Grid -->
  <section class="container-x pb-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {stories.map((s) => (
        <a href="#" class="group card !p-0 overflow-hidden flex flex-col hover:shadow-lg transition">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={photo(s.seed, 600, 450)} alt={s.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <span class="text-[10px] font-bold uppercase tracking-widest text-gold-600">{s.tag}</span>
            <h3 class="mt-2 font-display text-lg text-navy-700 leading-tight">{s.title}</h3>
            <p class="mt-2 text-sm text-ink-soft flex-1">{s.body}</p>
            <div class="mt-4 flex items-center justify-between text-xs text-ink-soft">
              <span>{s.read}</span>
              <span class="text-gold-600 font-semibold">Read →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Share your story CTA -->
  <section class="container-x pb-20">
    <div class="rounded-3xl bg-navy-700 text-white p-10 md:p-14 grid md:grid-cols-[1.4fr_1fr] gap-6 items-center">
      <div>
        <h2 class="font-display text-2xl md:text-3xl text-white">Have a story to tell?</h2>
        <p class="mt-3 text-cream/85 max-w-prose">If your cause, business, or community moment was lifted by Our Town, we'd love to feature it.</p>
      </div>
      <a href={link('/contact')} class="btn-primary md:justify-self-end">Share your story</a>
    </div>
  </section>
</BaseLayout>
