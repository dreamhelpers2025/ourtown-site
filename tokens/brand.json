{
  "$comment": "OurTown design tokens. Single source of truth for every generated asset. Values carried over from the ourtown.store site build (tailwind.config.mjs @ 1b98350) so campaign assets and the website cannot drift apart.",

  "color": {
    "$goldNote": "Ramp re-anchored on #f8a800, sampled from the supplied OurTown wordmark (OurTown_Logopng_yellow.png). The site build used #d99e23, which is noticeably duller than the actual logo -- ourtown.store should be brought to this value too.",
    "gold": {
      "50": "#fff8e8", "100": "#ffedc2", "200": "#ffd980", "300": "#fdc23f",
      "400": "#fbb314", "500": "#f8a800", "600": "#d18a00", "700": "#a66a04",
      "800": "#85540c", "900": "#6d450f"
    },
    "navy": {
      "50": "#eef4fb", "100": "#d4e3f3", "200": "#a9c5e6", "300": "#7ba6d5",
      "400": "#5187c1", "500": "#3b6fa9", "600": "#295f98", "700": "#234c7b",
      "800": "#1f3e63", "900": "#1a3450"
    },
    "heritage": {
      "500": "#c65a46", "600": "#a64332", "700": "#85342a"
    },
    "forest": {
      "500": "#4f6b58", "600": "#3f5648", "700": "#34463b"
    },
    "cream": { "DEFAULT": "#f7f2e8", "50": "#fdfaf3", "200": "#efe5cf", "300": "#e3d4ad" },
    "ink": { "DEFAULT": "#2f2f2f", "soft": "#5a5651" },
    "white": "#ffffff"
  },

  "role": {
    "$comment": "Semantic roles. Templates reference these, never raw ramp values.",
    "brand": "{color.gold.500}",
    "brandDeep": "{color.gold.700}",
    "accent": "{color.navy.600}",
    "surface": "{color.cream.DEFAULT}",
    "surfaceAlt": "{color.cream.50}",
    "text": "{color.ink.DEFAULT}",
    "textSoft": "{color.ink.soft}",
    "onBrand": "{color.ink.DEFAULT}",
    "onAccent": "{color.white}"
  },

  "brandAssets": {
    "$comment": "Path relative to the repo root. Note the mark reads 'OUR TOWN' as two words. Both supplied PNGs are gold (#e0a030 and #f0a000); the black wordmark exists only as a JPEG with no transparency, so the dark variant is derived from this one with a brightness(0) filter rather than shipping a knocked-out JPEG.",
    "wordmark": "campaigns/assets/volcanoes-vyb/OurTown_Logopng_yellow.png"
  },

  "font": {
    "display": "Poppins, 'Nunito Sans', system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "webfontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 }
  },

  "radius": { "sm": "8px", "md": "16px", "lg": "28px", "pill": "999px" },

  "shadow": {
    "card": "0 4px 20px -8px rgba(47,47,47,0.12)",
    "soft": "0 2px 12px -4px rgba(47,47,47,0.08)",
    "lift": "0 18px 48px -18px rgba(47,47,47,0.45)"
  },

  "spacingScale": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128],

  "rules": {
    "$comment": "Machine-readable constraints. These are the automation spec: enforced in code, not just documented in a PDF.",
    "businessName": { "maxLength": 40 },
    "causeName": { "maxLength": 40 },
    "headline": { "maxLength": 48, "autoFit": true, "minScale": 0.62 },
    "product": { "transparentPng": true, "minWidthPx": 1500 },
    "qr": { "minInches": 1.25, "quietZoneModules": 2, "position": "lower-right" },
    "ourtownLogo": { "position": "footer", "alwaysPresent": true },
    "disclosure": { "required": true, "minPtAtLetter": 8 },
    "contrast": { "minRatioLargeText": 3.0, "minRatioBodyText": 4.5 }
  },

  "voice": {
    "$comment": "Campaign-system messaging. The platform speaks in community identity, not fundraising asks.",
    "platformTagline": "Shop Local. Give Local.",
    "poweredBy": "Powered by OurTown",
    "headlines": [
      "Wear Your Community.",
      "Your Purchase Changes Where You Live.",
      "Local Pride. Local Impact.",
      "Buy Here. Build Here."
    ]
  },

  "badges": {
    "shop-local":       { "label": "Shop Local",        "icon": "🛍️", "tone": "brand" },
    "gives-back":       { "label": "Gives Back",        "icon": "❤️",       "tone": "heritage" },
    "community-partner":{ "label": "Community Partner", "icon": "🤝",       "tone": "accent" },
    "team-partner":     { "label": "Official Team Partner", "icon": "🏀", "tone": "accent",
                          "$requires": "A signed partnership agreement. This badge asserts an official relationship." },
    "local-impact":     { "label": "Local Impact",      "icon": "🌲",       "tone": "forest" }
  }
}
